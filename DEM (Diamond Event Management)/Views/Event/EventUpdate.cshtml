@model DEM__Diamond_Event_Management_.Models.EventVM

@{
    ViewBag.Title = "Events";
    Layout = "_AdminLayout";
    <link rel="stylesheet" href="/css/event.css">
}

<div class="event-update-container">
    <h1 class="event-update-title">Add New Events</h1>
    <div class="event-update-body">
        <form method="post" class="form" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="event-update-body-row-one">
                <div class="event-update-input-box">
                    <label asp-for="Id"></label>
                    <input asp-for="Id" readonly>
                    <span asp-validation-for="Id"></span>
                </div>
                <div class="event-update-input-box">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" data-trim />
                    <span asp-validation-for="Name"></span>
                </div>
                <div class="event-update-input-box">
                    <label asp-for="Price"></label>
                    <input asp-for="Price"  data-trim />
                    <span asp-validation-for="Price"></span>
                </div>
            </div>

            <div class="event-update-body-description">
                <div class="event-update-input-box">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" data-trim></textarea>
                    <span asp-validation-for="Description"></span>
                </div>
            </div>

            <div class="event-update-body-row-two">
                <div class="event-update-input-box">
                    <label asp-for="StartDate"></label>
                    <input asp-for="StartDate" data-trim />
                    <span asp-validation-for="StartDate"></span>
                </div>
                <div class="event-update-input-box">
                    <label asp-for="EndDate"></label>
                    <input asp-for="EndDate" data-trim />
                    <span asp-validation-for="EndDate"></span>
                </div>
                <div class="event-update-input-box">
                    <label asp-for="StartTime"></label>
                    <input asp-for="StartTime" data-trim />
                    <span asp-validation-for="StartTime"></span>
                </div>
                <div class="event-update-input-box">
                    <label asp-for="EndTime"></label>
                    <input asp-for="EndTime" data-trim />
                    <span asp-validation-for="EndTime"></span>
                </div>
            </div>

            <div class="event-update-body-row-three">
                <div class="event-update-input-box">
                    <label>Photo</label>
                    <label class="event-update-poster-upload upload">
                        <input type="file" name="posterFile" accept="image/jpeg,image/png,image/jpg" hidden>
                        <img src="~/uploads/@Model.PosterImg">
                    </label>
                    @Html.ValidationMessage("posterFile")
                </div>
                <div class="event-update-input-box">
                    <label>Banner</label>
                    <label class="event-update-banner-upload upload">
                        <input type="file" name="bannerFile" accept="image/jpeg,image/png,image/jpg" hidden>
                        <img src="~/uploads/@Model.BannerImg">
                    </label>
                    @Html.ValidationMessage("bannerFile")
                </div>
            </div>
            <div class="event-create-body-row-four">
                <div class="event-create-input-box">
                    <label asp-for="Status"></label>
                    <select asp-for="Status">
                        <option value="">- Select One -</option>
                        <option value="Upcoming">Upcoming</option>
                        <option value="Ongoing">Ongoing</option>
                        <option value="Completed">Completed</option>
                        <option value="Hidden">Hidden</option>
                    </select>
                    <span asp-validation-for="Status"></span>
                </div>
                <div class="event-update-input-box">
                    <label asp-for="VenueId"></label>
                    <select asp-for="VenueId" asp-items="ViewBag.VenueList">
                        <option value="">- Select One -</option>
                    </select>
                    <span asp-validation-for="VenueId"></span>
                </div>
                <div class="event-update-input-box">
                    <label asp-for="CategoryId"></label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryList">
                        <option value="">- Select One -</option>
                    </select>
                    <span asp-validation-for="CategoryId"></span>
                </div>
            </div>

            <section>
                <button class="event-update-btn-submit">Submit</button>
                <button type="reset" class="event-update-btn-reset">Reset</button>
            </section>
        </form>
    </div>
</div>
<br />

<a href="/Event/EventRead" class="event-update-btn-return">Return</a>
