@model DEM__Diamond_Event_Management_.Models.EventVM

@{
    ViewBag.Title = "Events";
    Layout = "_AdminLayout";
    
}

<div class="event-create-container">
    <h1 class="event-create-title">Add New Events</h1>
    <div class="event-create-body">
        <form method="post" class="form" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="event-create-body-row-one">
                <div class="event-create-input-box">
                    <label asp-for="Id"></label>
                    <input asp-for="Id" data-upper autofocus>
                    <span asp-validation-for="Id"></span>
                </div>
                <div class="event-create-input-box">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" data-trim />
                    <span asp-validation-for="Name"></span>
                </div>
                <div class="event-create-input-box">
                    <label asp-for="Price"></label>
                    <input asp-for="Price" data-trim />
                    <span asp-validation-for="Price"></span>
                </div>
            </div>

            <div class="event-create-body-description">
                <div class="event-create-input-box">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description"  data-trim></textarea>
                    <span asp-validation-for="Description"></span>
                </div>
            </div>

            <div class="event-create-body-row-two">
                <div class="event-create-input-box">
                    <label asp-for="StartDate"></label>
                    <input asp-for="StartDate" data-trim />
                    <span asp-validation-for="StartDate"></span>
                </div>
                <div class="event-create-input-box">
                    <label asp-for="EndDate"></label>
                    <input asp-for="EndDate" data-trim />
                    <span asp-validation-for="EndDate"></span>
                </div>
                <div class="event-create-input-box">
                    <label asp-for="StartTime"></label>
                    <input asp-for="StartTime" data-trim />
                    <span asp-validation-for="StartTime"></span>
                </div>
                <div class="event-create-input-box">
                    <label asp-for="EndTime"></label>
                    <input asp-for="EndTime" data-trim />
                    <span asp-validation-for="EndTime"></span>
                </div>
            </div>

            <div class="event-create-body-row-three">
                <div class="event-create-input-box">
                        <label>Photo</label>
                        <label class="event-create-poster-upload upload">
                            <input type="file" name="PosterImg" accept="image/jpeg,image/png,image/jpg" hidden>
                            <img src="/images/icon/upload-image.png">
                        </label>
                        @Html.ValidationMessage("PosterImg")
                </div>
                <div class="event-create-input-box">
                    <label>Banner</label>
                    <label class="event-create-banner-upload upload">
                        <input type="file" name="BannerImg" accept="image/jpeg,image/png,image/jpg" hidden>
                        <img src="/images/icon/upload-image.png">
                    </label>
                    @Html.ValidationMessage("BannerImg")
                </div>
            </div>

            <div class="event-create-body-row-four">
                <div class="event-create-input-box">
                    <label asp-for="Status"></label>
                    <input asp-for="Status" data-trim />
                    <span asp-validation-for="Status"></span>
                </div>
                <div class="event-create-input-box">
                    <label asp-for="VenueId"></label>
                    <select asp-for="VenueId" asp-items="ViewBag.VenueList">
                        <option value="">- Select One -</option>
                    </select>
                    <span asp-validation-for="VenueId"></span>
                </div>
                <div class="event-create-input-box">
                    <label asp-for="CategoryId"></label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryList">
                        <option value="">- Select One -</option>
                    </select>
                    <span asp-validation-for="CategoryId"></span>
                </div>
            </div>

            <section>
                <button class="event-create-btn-submit">Submit</button>
                <button type="reset" class="event-create-btn-reset">Reset</button>
            </section>
        </form>
    </div>
</div>
<br />
<a href="/Event/EventRead" class="event-create-btn-return">Return</a>
