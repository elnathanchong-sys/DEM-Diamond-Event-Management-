@*IEnumerable is used so that they can output list from the database*@
@model IEnumerable<DEM__Diamond_Event_Management_.Models.EventVM>

@{
    ViewBag.Title = "Events";
    Layout = "_AdminLayout";
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bree+Serif&display=swap" rel="stylesheet">

}

<body>
    <div class="event-container">
            <div class="event-header">
                <h1 class="event-title">Events</h1>
                <div class="search-section">
                <form method="get" action="/Event/EventRead">
                    <input type="search"
                           name="name"
                           class="search-input"
                           placeholder="Search event..."
                           value="@Context.Request.Query["name"]" />
                </form>
                </div>
                <a href="/Event/EventCreate" class="create-new-btn">+ Create New Event</a>
            </div>

        <div class="event-record-amount">
            <p>@Model.Count() record(s)</p>
        </div>

        <div class="event-list-container">

            @foreach (var e in Model)
                {
                    <div class="event-info-row">
                        <div class="event-info">
                            <strong>@e.Id</strong> 
                            @e.Name
                        </div>

                        <div class="event-action-btns">
                            <a href="/Event/EventUpdate/@e.Id" class="btn-update">Update</a>
                            <button data-post="/Event/EventDelete/@e.Id" class="btn-delete">Delete</button>
                        </div>
                    </div>
                }
        </div>
    </div>
</body>