@model DEM__Diamond_Event_Management_.Models.ForgotPasswordViewModel
@{
    Layout = "_LoginLayout";
    ViewBag.Title = "Forgot Password";
}

<div class="page-container">
    <div class="login-card">
        <div class="login-left">
            <a href="/Account/Login">Back</a>
            <div class="brand-logo">Diamond Event Management</div>
            <h1 class="login-title">Forgot Password</h1>

            <div asp-validation-summary="All" class="error-message"></div>

            <form class="login-form" method="post" asp-action="ForgotPassword">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="Email">Registered Email</label>
                    <input type="email" asp-for="Email" placeholder="username@gmail.com" required />
                    <span asp-validation-for="Email" class="error-message"></span>
                </div>

                <button type="submit" class="btn-signin" style="margin-top: 20px;">
                    Send Reset Link
                </button>
            </form>
        </div>

        <div class="login-right">
            <img src="~/images/loginimage.png" alt="Banner" class="banner-image" />
        </div>
    </div>
</div>