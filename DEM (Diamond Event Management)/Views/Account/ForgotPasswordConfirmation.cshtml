@{
    Layout = "_LoginLayout";
    ViewBag.Title = "Reset Link Sent";
}

<div class="page-container">
    <div class="login-card">
        <div class="login-left">
            <a href="/Account/Login">Back to Login</a>
            <div class="brand-logo">Diamond Event Management</div>

            <h1 class="login-title">Check Your Email</h1>

            <div style="margin: 25px 0; font-size: 1rem; color: #495057; line-height: 1.6;">
                <p>If an account exists for that email, a password reset link has been sent.</p>
                <p>Please check your registered email inbox (and spam folder) to proceed with resetting your password.</p>
            </div>

            <a href="/Account/Login" class="btn-signin" style="display: block; text-align: center; text-decoration: none; margin-top: 30px; line-height: 40px;">
                Return to Login
            </a>
        </div>

        <div class="login-right">
            <img src="https://picsum.photos/id/1015/800/1000" alt="Banner" class="banner-image" />
        </div>
    </div>
</div>