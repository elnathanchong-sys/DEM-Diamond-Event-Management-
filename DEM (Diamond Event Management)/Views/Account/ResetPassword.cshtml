@model DEM__Diamond_Event_Management_.Models.ResetPasswordViewModel
@{
    Layout = "_LoginLayout";
    ViewBag.Title = "Reset Password";
}

<div class="page-container">
    <div class="login-card">
        <div class="login-left">
            <a href="/Account/Login">Back to Login</a>
            <div class="brand-logo">Diamond Event Management</div>
            <h1 class="login-title">Reset Password</h1>

            <div asp-validation-summary="All" class="error-message"></div>

            <form class="login-form" method="post" asp-action="ResetPassword">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />

                <div class="form-group">
                    <label for="Password">New Password</label>
                    <input type="password" asp-for="Password" placeholder="Enter new password" required />
                    <span asp-validation-for="Password" class="error-message"></span>
                </div>

                <div class="form-group">
                    <label for="ConfirmPassword">Confirm Password</label>
                    <input type="password" asp-for="ConfirmPassword" placeholder="Confirm new password" required />
                    <span asp-validation-for="ConfirmPassword" class="error-message"></span>
                </div>

                <button type="submit" class="btn-signin" style="margin-top: 20px;">
                    Update Password
                </button>
            </form>
        </div>

        <div class="login-right">
            <img src="https://picsum.photos/id/1015/800/1000" alt="Banner" class="banner-image" />
        </div>
    </div>
</div>