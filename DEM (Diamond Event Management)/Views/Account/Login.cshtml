@model DEM__Diamond_Event_Management_.Models.LoginViewModel
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bree+Serif&display=swap" rel="stylesheet">
@{
    Layout = "_LoginLayout";
    ViewBag.Title = "Login";
}

<div class="page-container">
    <div class="login-card">

        <!--Left side Login -->
        
        <div class="login-left">

            <a href="/Home/Index">Back</a>
            <div class="brand-logo">Diamond Event Management</div>

            <h1 class="login-title">Login</h1>

            <div asp-validation-summary="All" class="error-message"></div>
            <form class="login-form" method="post" asp-action="Login">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" asp-for="Email" placeholder="username@gmail.com" required />
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" asp-for="Password" placeholder="Password" required />
                </div>

                <div class="forgot-wrapper">
                    <a href="#" class="forgot-link">Forgot Password?</a>
                </div>

                <button type="submit" class="btn-signin">
                    Sign in
                </button>

                @if (ViewBag.Error != null)
                {
                    <p class="error-message">
                        @ViewBag.Error
                    </p>
                }

            </form>

            <p class="register-text">
                Don't have an account yet? <a href="/Account/CreateAccount" class="register-link">Register for free</a>
            </p>
        </div>

        
        <!-- Right side pic  -->
        
        <div class="login-right">

            
            <img src="https://picsum.photos/id/1015/800/1000" alt="Login Banner" class="banner-image" />
            
            <div class="image-overlay">
                <h2>Welcome New User!</h2>
                <p>We are glad to see you again.</p>
            </div>
        </div>

    </div>
</div>
