@model DEM__Diamond_Event_Management_.Models.LoginViewModel

@{
    Layout = "_LoginLayout";
}

<div class="box2">
    <div class="box">
        <div class="brand-logo text-center mb-4">Your logo</div>

        <h2 class="login-title mb-4">Login</h2>

        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Query["returnURL"]" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="username@gmail.com" autocomplete="on">
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" placeholder="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-actions-row mb-4">
                <a href="#" class="forgot-password-link">Forgot Password?</a>
            </div>

            <div class="form-group mb-4">
                <button type="submit" class="btn btn-login w-100">Sign in</button>
            </div>
        </form>

        <div class="login-footer text-center">
            <p>Don't have an account yet? <a href="/Account/CreateAccount">Register for free</a></p>
        </div>
    </div>
</div>