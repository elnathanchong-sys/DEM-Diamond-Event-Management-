@model DEM__Diamond_Event_Management_.Models.EventVM

@{
    ViewBag.Title = "Dashboard";
    Layout = "_AdminLayout";
    var activeRate = Model.TotalEvents > 0 ? (double)Model.TotalOngoing / Model.TotalEvents * 100 : 0;
    var pendingRate = Model.TotalEvents > 0 ? (double)Model.TotalPending / Model.TotalEvents * 100 : 0;
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-dashboard">
    <header class="dashboard-header">
        <div>
            <p class="dashboard-kicker"><i class="fa-solid fa-chart-line"></i> Operations overview</p>
            <h1>Good day, Admin</h1>
            <p class="dashboard-subtitle">Monitor tournament activity, registration momentum, and revenue at a glance.</p>
        </div>
        <div class="dashboard-date"><i class="fa-regular fa-calendar"></i> @DateTime.Now.ToString("dddd, dd MMM yyyy")</div>
    </header>

    <section class="dashboard-metrics" aria-label="Dashboard summary">
        <article class="dashboard-metric metric-blue"><div class="metric-icon"><i class="fa-solid fa-trophy"></i></div><div><span>Total tournaments</span><strong>@Model.TotalEvents</strong><small>All scheduled events</small></div></article>
        <article class="dashboard-metric metric-green"><div class="metric-icon"><i class="fa-solid fa-bolt"></i></div><div><span>Ongoing now</span><strong>@Model.TotalOngoing</strong><small>@activeRate.ToString("0")% of all tournaments</small></div></article>
        <article class="dashboard-metric metric-amber"><div class="metric-icon"><i class="fa-solid fa-hourglass-half"></i></div><div><span>Pending review</span><strong>@Model.TotalPending</strong><small>@pendingRate.ToString("0")% awaiting action</small></div></article>
        <article class="dashboard-metric metric-purple"><div class="metric-icon"><i class="fa-solid fa-wallet"></i></div><div><span>Total revenue</span><strong>RM @Model.TotalRevenue.ToString("N2")</strong><small>Recorded payments</small></div></article>
    </section>

    <div class="dashboard-grid">
        <section class="dashboard-panel recent-panel">
            <div class="panel-heading"><div><p class="panel-eyebrow">Schedule</p><h2>Recent tournaments</h2></div><a asp-controller="Event" asp-action="EventRead" class="panel-link">View all <i class="fa-solid fa-arrow-right"></i></a></div>
            @if (Model.RecentEvents.Any())
            {
                <div class="tournament-list">
                    @foreach (var tournament in Model.RecentEvents)
                    {
                        <a class="tournament-row" asp-controller="Event" asp-action="EventIndividual" asp-route-id="@tournament.Id">
                            <span class="tournament-mark"><i class="fa-solid fa-gamepad"></i></span><span class="tournament-details"><strong>@tournament.Name</strong><small>@tournament.StartDate.ToString("dd MMM yyyy")</small></span><span class="dashboard-status status-@tournament.Status.ToLowerInvariant()">@tournament.Status</span><i class="fa-solid fa-chevron-right row-arrow"></i>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="dashboard-empty"><i class="fa-regular fa-calendar-xmark"></i><p>No tournaments found.</p></div>
            }
        </section>

        <section class="dashboard-panel trending-panel">
            <div class="panel-heading"><div><p class="panel-eyebrow">Registration activity</p><h2>Trending tournaments</h2></div><span class="trend-badge"><i class="fa-solid fa-arrow-trend-up"></i> Top 5</span></div>
            @if (Model.TrendingEvents.Any())
            {
                <div class="trending-list">
                    @foreach (var tournament in Model.TrendingEvents)
                    {
                        <a class="trending-row" asp-controller="Event" asp-action="EventIndividual" asp-route-id="@tournament.Id">
                            <span class="trend-rank">@(Model.TrendingEvents.IndexOf(tournament) + 1)</span><span class="trend-details"><strong>@tournament.Name</strong><small>@tournament.RegisteredPeople @(tournament.RegisteredPeople == 1 ? "person" : "people") registered</small></span><strong class="trend-percent">@tournament.RegisteredPeople</strong>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="dashboard-empty"><i class="fa-solid fa-chart-simple"></i><p>No registration activity yet.</p></div>
            }
        </section>
    </div>
</div>
