@model DEM__Diamond_Event_Management_.Models.AdminUserEditViewModel
@{
    ViewBag.Title = "Create Member";
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="~/css/admin.css" />

<div class="admin-wrapper">
    <div class="admin-header">
        <h1>Create Member</h1>
        <a asp-action="ReadUser" class="category-create-btn-return">← Back to List</a>
    </div>

    <form asp-action="CreateUser" method="post" class="category-create-body">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" class="form-control" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Name">Full Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Gender">Gender</label>
            <select asp-for="Gender" class="form-control">
                <option value="M">Male</option>
                <option value="F">Female</option>
            </select>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Phone">Phone</label>
            <input asp-for="Phone" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="Country">Country</label>
            <input asp-for="Country" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="State">State</label>
            <input asp-for="State" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="City">City</label>
            <input asp-for="City" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="HouseNo">House No</label>
            <input asp-for="HouseNo" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="Address">Address</label>
            <input asp-for="Address" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="MembershipLevel">Membership Level</label>
            <select asp-for="MembershipLevel" class="form-control">
                <option>Silver</option>
                <option>Gold</option>
                <option>Platinum</option>
            </select>
        </div>

        <button type="submit" class="category-create-btn-submit">Save Member</button>
    </form>
</div>
