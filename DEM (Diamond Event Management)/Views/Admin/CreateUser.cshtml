@model DEM__Diamond_Event_Management_.Models.AdminUserEditViewModel
@{
    ViewBag.Title = "Create Member";
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="~/css/edit-forms.css" />

<div class="edit-screen edit-screen--wide">
    <header class="edit-screen-header">
        <div>
            <span class="edit-screen-kicker"><i class="fa-solid fa-user-plus"></i> Member management</span>
            <h1>Add Member</h1>
            <p class="edit-screen-subtitle">Create a new member account and set their profile details.</p>
        </div>
        <a asp-action="ReadUser" class="edit-screen-back"><i class="fa-solid fa-arrow-left"></i> Member list</a>
    </header>

    <form asp-action="CreateUser" method="post" class="edit-screen-card edit-screen-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="edit-screen-validation"></div>

        <div class="edit-screen-grid">
            <div class="edit-screen-field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" placeholder="Email address" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="edit-screen-field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" placeholder="Create a password" />
                <span asp-validation-for="Password"></span>
            </div>

            <div class="edit-screen-field">
                <label asp-for="Name">Full Name</label>
                <input asp-for="Name" placeholder="Enter the member's full name" />
                <span asp-validation-for="Name"></span>
            </div>

            <div class="edit-screen-field">
                <label asp-for="Gender">Gender</label>
                <select asp-for="Gender">
                    <option value="M">Male</option>
                    <option value="F">Female</option>
                </select>
                <span asp-validation-for="Gender"></span>
            </div>

            <div class="edit-screen-field">
                <label asp-for="Phone">Phone</label>
                <input asp-for="Phone" placeholder="Phone number" />
            </div>

            <div class="edit-screen-field">
                <label asp-for="Country">Country</label>
                <input asp-for="Country" placeholder="Country" />
            </div>

            <div class="edit-screen-field">
                <label asp-for="State">State</label>
                <input asp-for="State" placeholder="State" />
            </div>

            <div class="edit-screen-field">
                <label asp-for="City">City</label>
                <input asp-for="City" placeholder="City" />
            </div>

            <div class="edit-screen-field">
                <label asp-for="HouseNo">House No</label>
                <input asp-for="HouseNo" placeholder="House number" />
            </div>

            <div class="edit-screen-field edit-screen-field--full">
                <label asp-for="Address">Address</label>
                <textarea asp-for="Address" rows="3" placeholder="Street address"></textarea>
            </div>

            <div class="edit-screen-field">
                <label asp-for="MembershipLevel">Membership Level</label>
                <select asp-for="MembershipLevel">
                    <option>Silver</option>
                    <option>Gold</option>
                    <option>Platinum</option>
                </select>
            </div>
        </div>

        <div class="edit-screen-actions">
            <a asp-action="ReadUser" class="edit-screen-cancel">Cancel</a>
            <button type="submit" class="edit-screen-submit"><i class="fa-solid fa-check"></i> Save Member</button>
        </div>
    </form>
</div>
