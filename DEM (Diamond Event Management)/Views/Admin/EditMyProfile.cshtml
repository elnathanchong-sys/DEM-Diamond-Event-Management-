@model DEM__Diamond_Event_Management_.Models.AdminEditViewModel
@{
    ViewBag.Title = "Edit My Profile";
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="~/css/Category.css" />

<div class="category-update-container">
    <a asp-action="Index" class="category-update-btn-return">← Back to Dashboard</a>
    <h2 class="category-update-title">Edit My Admin Profile</h2>

    <form asp-action="EditMyProfile" method="post" class="category-update-body">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" style="color: #ff6b6b; margin-bottom: 10px;"></div>

        <div class="category-update-body-row-one">
            <div style="flex: 1;">
                <label style="display: block; margin-bottom: 5px;">Email (Read Only)</label>
                <input value="@Model.Email" disabled style="width: 100%; padding: 10px; background-color: #343A40; color: #aaa; border: 1px solid #444; border-radius: 10px;" />
            </div>
            <div style="flex: 1;">
                <label asp-for="Name" style="display: block; margin-bottom: 5px;">Full Name</label>
                <input asp-for="Name" style="width: 100%; padding: 10px; background-color: #495057; color: #fff; border: 1px solid #444; border-radius: 10px;" />
                <span asp-validation-for="Name" style="color: #ff6b6b;"></span>
            </div>
        </div>

        <div class="category-update-body-row-one">
            <div style="flex: 1;">
                <label asp-for="Gender" style="display: block; margin-bottom: 5px;">Gender</label>
                <select asp-for="Gender" style="width: 100%; padding: 10px; background-color: #495057; color: #fff; border: 1px solid #444; border-radius: 10px; font-family: 'Bree Serif', serif;">
                    <option value="M">Male</option>
                    <option value="F">Female</option>
                </select>
                <span asp-validation-for="Gender" style="color: #ff6b6b;"></span>
            </div>
            <div style="flex: 1;">
                <label asp-for="Phone" style="display: block; margin-bottom: 5px;">Phone Number</label>
                <input asp-for="Phone" style="width: 100%; padding: 10px; background-color: #495057; color: #fff; border: 1px solid #444; border-radius: 10px;" />
                <span asp-validation-for="Phone" style="color: #ff6b6b;"></span>
            </div>
        </div>

        <div style="margin-bottom: 20px;">
            <label asp-for="NewPassword" style="display: block; margin-bottom: 5px;">New Password (leave blank to keep current)</label>
            <input asp-for="NewPassword" type="password" style="width: 100%; padding: 10px; background-color: #495057; color: #fff; border: 1px solid #444; border-radius: 10px;" />
            <span asp-validation-for="NewPassword" style="color: #ff6b6b;"></span>
        </div>

        <div>
            <button type="submit" class="category-update-btn-submit">Update Profile</button>
            <a asp-action="Index" class="category-update-btn-reset" style="display: inline-block;">Cancel</a>
        </div>
    </form>
</div>
