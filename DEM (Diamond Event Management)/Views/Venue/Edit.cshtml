@{
    Layout = "_AdminLayout";
    ViewBag.Title = "Edit Venue";
}

@section head {
    <link rel="stylesheet" href="~/css/venue.css" />
}

@model DEM__Diamond_Event_Management_.Models.Venue

<div class="venue-page">

    <div class="venue-header">
        <h1>Edit Venue</h1>
        <p>Update the details of this venue.</p>
    </div>

    <div class="venue-card">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div class="form-row">

                <div class="form-group">
                    <label asp-for="Id">Venue ID</label>
                    <input asp-for="Id" disabled />
                </div>

                <div class="form-group">
                    <label asp-for="VenueName">Venue Name</label>
                    <input asp-for="VenueName"
                           placeholder="Enter venue name..." />
                    <span asp-validation-for="VenueName"></span>
                </div>

            </div>

            <div class="form-row">

                <div class="form-group">
                    <label asp-for="Location">Location</label>
                    <input asp-for="Location"
                           placeholder="Enter venue location..." />
                    <span asp-validation-for="Location"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Capacity">Capacity</label>
                    <input asp-for="Capacity"
                           type="number"
                           placeholder="Enter capacity..." />
                    <span asp-validation-for="Capacity"></span>
                </div>

            </div>

            <div class="form-group">
                <label asp-for="VenueCapacity">Venue Capacity</label>
                <input asp-for="VenueCapacity"
                       type="number"
                       placeholder="Enter venue capacity..." />
                <span asp-validation-for="VenueCapacity"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description"
                          placeholder="Enter venue description..."></textarea>
                <span asp-validation-for="Description"></span>
            </div>

            <div class="form-buttons">

                <button type="submit" class="save-btn">
                    Save Changes
                </button>

                <a asp-action="Index" class="cancel-btn">
                    Return
                </a>

            </div>

        </form>

    </div>

</div>