@{
    Layout = "_AdminLayout";
    ViewBag.Title = "Venue";
}

@section head {
    <link rel="stylesheet" href="~/css/venue.css" />
}

@model IEnumerable<DEM__Diamond_Event_Management_.Models.Venue>

<div class="venue-page">

    <div class="venue-header">
        <h1>Venue Management</h1>
        <p>Manage all available venues.</p>
    </div>

    <div class="venue-toolbar">

        <div class="record-count">
            Total Records: <strong>@Model.Count()</strong>
        </div>

        <div class="search-container">
            <input type="text"
                   id="venueSearch"
                   placeholder="Search venues..."
                   onkeyup="searchVenues()" />
        </div>

        <div class="venue-actions">
            <a asp-action="Create" class="add-btn">
                + Add Venue
            </a>
        </div>

    </div>

    <div class="venue-table-card">

        <table class="venue-table" id="venueTable">

            <thead>
                <tr>
                    <th>Id</th>
                    <th>Venue Name</th>
                    <th>Location</th>
                    <th>Capacity</th>
                    <th>Venue Capacity</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var venue in Model)
                {
                    <tr>
                        <td>@venue.Id</td>
                        <td>@venue.VenueName</td>
                        <td>@venue.Location</td>
                        <td>@venue.Capacity</td>
                        <td>@venue.VenueCapacity</td>
                        <td>@venue.Description</td>

                        <td class="action-buttons">
                            <a asp-action="Edit"
                               asp-route-id="@venue.Id"
                               class="edit-btn">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@venue.Id"
                               class="delete-btn"
                               onclick="return confirm('Are you sure you want to delete this venue?');">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>

</div>

<script>
    function searchVenues() {
        var input = document.getElementById("venueSearch");
        var filter = input.value.toLowerCase();
        var table = document.getElementById("venueTable");
        var rows = table.getElementsByTagName("tr");

        for (var i = 1; i < rows.length; i++) {
            var text = rows[i].textContent.toLowerCase();

            if (text.includes(filter)) {
                rows[i].style.display = "";
            } else {
                rows[i].style.display = "none";
            }
        }
    }
</script>