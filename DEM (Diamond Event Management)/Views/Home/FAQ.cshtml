@{
    ViewData["Title"] = "FAQs";
}

<link rel="stylesheet" href="~/css/faq.css" />

<div class="faq-page">
    <section class="faq-hero">
        <p class="faq-eyebrow">DIAMOND EVENT MANAGEMENT</p>
        <h1>Frequently Asked Questions</h1>
        <p class="faq-intro">
            Find quick answers about events, registration, payments and your DEM account.
        </p>
    </section>

    <section class="faq-content" aria-label="Frequently asked questions">
        <div class="faq-group">
            <p class="faq-group-label">Getting started</p>
            <h2>Before you register</h2>

            <details open>
                <summary>What is Diamond Event Management?</summary>
                <p>DEM is a gaming event platform where players can discover tournaments, register for events and follow their registrations in one place.</p>
            </details>

            <details>
                <summary>How do I find an event?</summary>
                <p>Open the Events page to browse available events. You can search by name and filter the list by status or category.</p>
            </details>

            <details>
                <summary>Do I need an account to register?</summary>
                <p>Yes. Sign in or create an account before registering so DEM can associate your registration, payment and event updates with you.</p>
            </details>
        </div>

        <div class="faq-group">
            <p class="faq-group-label">Registration and payment</p>
            <h2>Joining an event</h2>

            <details>
                <summary>How do I register for an event?</summary>
                <p>Choose an event from the Events page, open its details and select the registration option. Complete the requested information, then submit the form.</p>
            </details>

            <details>
                <summary>How can I check my registration status?</summary>
                <p>After signing in, open your profile to view your registrations and their current status.</p>
            </details>

            <details>
                <summary>When is my registration confirmed?</summary>
                <p>Your registration is confirmed when its status changes to approved or confirmed. Check the event and your profile for the latest update.</p>
            </details>
        </div>

        <div class="faq-group">
            <p class="faq-group-label">Account help</p>
            <h2>Managing your details</h2>

            <details>
                <summary>How do I update my profile?</summary>
                <p>Sign in and open your profile. From there you can update the personal information available on your account.</p>
            </details>

            <details>
                <summary>What should I do if I forget my password?</summary>
                <p>Use the Forgot Password option on the login page and follow the instructions sent to your registered email address.</p>
            </details>

            <details>
                <summary>Where can I get more help?</summary>
                <p>Check the event information first for event-specific details. For account or registration issues, contact the DEM team with your account email and event name.</p>
            </details>
        </div>
    </section>
</div>