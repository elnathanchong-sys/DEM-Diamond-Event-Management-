@{
    // Set the page title
    ViewData["Title"] = "Home";
    Layout = "_Layout";
    var indexBanner = ViewBag.indexBanner as List<DEM__Diamond_Event_Management_.Models.IndexBannerVM> ?? new List<DEM__Diamond_Event_Management_.Models.IndexBannerVM>();
}

<div class="banner-img-carousel-container">
    <div class="banner-img-carousel-wrapper">
        <div class="banner-img-carousel-slider">
            @foreach (var b in indexBanner)
            {
                <img src="~/uploads/@b.IndexBannerImg" alt="@b.Name" class="index-banner-img" />
            }
        </div>

        <div class="banner-img-carousel-nav">
            @for (int i = 0; i < indexBanner.Count; i++)
            {
                <a href="javascript:void(0)" class="dot @(i == 0 ? "active" : "")" data-index="@i"></a>
            }
        </div>
        <div class="next-prev-btn">
            <span class="next">&#10095</span>
            <span class="prev">&#10094</span>
        </div>
    </div>
</div>

<div class="index-events">
    <div class="index-events-nav">
        <div class="index-events-title">
            <h1>Events</h1>
        </div>

        <div class="index-events-status">
            <p>
                @foreach (var s in ViewBag.Status) // Reminder to self : ViewBag can be found in the controller
                {
                    if (s == ViewBag.CurrentStatus)
                    {
                        // Tab when selected by user (active)
                        <a data-ajax="true"
                           data-ajax-update="#index-event-target"
                           class="status-tab active"
                           href="?Status=@s">@s</a>
                    }
                    else
                    {
                        // Inactive tab when not selected by user
                        <a data-ajax="true"
                           data-ajax-update="#index-event-target"
                           class="status-tab"
                           href="?Status=@s">@s</a>
                    }
                    <text> </text>
                }

            </p>
        </div>
    </div>



    <div id="index-event-target">
        <partial name="_Event" />
    </div>
</div>

<div class="index-ad">
    <h1>Diamond Event Management <br> The Best of the Best</h1>
</div>

<div class="map-section">

