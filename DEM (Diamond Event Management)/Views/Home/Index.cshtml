@{
    // Set the page title
    ViewData["Title"] = "Home";
    Layout = "_Layout";

}

@section head {
    <link rel="stylesheet" href="~/css/home.css" />
}

<header class="hero">

    <!-- Hero Content -->
    <div class="hero-content">

        <!-- Text -->
        <div class="hero-text">

            <h5>WELCOME TO</h5>

            <h1>
                Diamond Event<br />
                Management
            </h1>

            <p>
                Manage your diamond events with elegance and precision.
                Plan, organize and create unforgettable experiences.
            </p>

            <div class="buttons">
                <a href="#" class="btn-primary">View Events</a>
                <a href="#" class="btn-secondary">Manage Guests</a>
            </div>

        </div>

        <!-- Image -->
        <div class="right">
            <img src="~/images/diamond.png" alt="Diamond">
        </div>

    </div>

</header>