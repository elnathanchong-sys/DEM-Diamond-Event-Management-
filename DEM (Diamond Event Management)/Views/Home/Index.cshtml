@{
    // Set the page title
    ViewData["Title"] = "Home";
}

@section head {
    <link rel="stylesheet" href="~/css/home.css" />
}

<header class="hero">

    <!-- Navigation Bar -->
    <nav class="navbar">

        <ul>
            <li><a href="#">Home</a></li>
            <li><a href="#">Events</a></li>
            <li><a href="#">Guests</a></li>
            <li><a href="#">Schedules</a></li>
            <li><a href="#">Contact</a></li>
        </ul>

        <a class="login-btn"
           asp-controller="Account"
           asp-action="Login">
            Login
        </a>

    </nav>

    <!-- Hero Content -->
    <div class="hero-content">

        <!-- Text -->
        <div class="hero-text">

            <h5>WELCOME TO</h5>

            <h1>
                Diamond Event<br />
                Management
            </h1>

            <p>
                Manage your diamond events with elegance and precision.
                Plan, organize and create unforgettable experiences.
            </p>

            <div class="buttons">
                <a href="#" class="btn-primary">View Events</a>
                <a href="#" class="btn-secondary">Manage Guests</a>
            </div>

        </div>

        <!-- Image -->
        <div class="right">
            <img src="~/images/diamond.png" alt="Diamond">
        </div>

    </div>

</header>