@{
    // Set the page title
    ViewData["Title"] = "Home";
    Layout = "_Layout";

}

<body>
    <div class="banner-img-carousel-container">
        <div class="banner-img-carousel-wrapper">
            <div class="banner-img-carousel-slider">
                <img id="banner-img-1" src="~/images/cs2.jpg" alt="Banner Image 1" />
                <img id="banner-img-2" src="~/images/valorant.jpg" alt="Banner Image 2" />
                <img id="banner-img-3" src="~/images/lol.jpg" alt="Banner Image 3" />
            </div>
            <div class="banner-img-carousel-nav">
                <a href="#banner-img-1" class="slider-dot"></a>
                <a href="#banner-img-2" class="slider-dot"></a>
                <a href="#banner-img-3" class="slider-dot"></a>
            </div>
        </div>
    </div>
</body>
