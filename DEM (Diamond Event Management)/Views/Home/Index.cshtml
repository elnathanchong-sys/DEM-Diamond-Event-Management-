@{
    // Set the page title
    ViewData["Title"] = "Home";
    Layout = "_Layout";

}


<div class="banner-img-carousel-container">
    <div class="banner-img-carousel-wrapper">
        <div class="banner-img-carousel-slider">
            <img src="~/images/banner/cs2.png" alt="Banner Image 1" />
            <img src="~/images/banner/valorant.png" alt="Banner Image 2" />
            <img src="~/images/banner/lol.png" alt="Banner Image 3" />
        </div>
        <div class="banner-img-carousel-nav">
            <a href="javascript:void(0)" class="dot active" data-index="0"></a>
            <a href="javascript:void(0)" class="dot" data-index="1"></a>
            <a href="javascript:void(0)" class="dot" data-index="2"></a>
        </div>

        <div class="next-prev-btn">
            <span class="next">&#10095</span>
            <span class="prev">&#10094</span>
        </div>
    </div>
</div>

<div class="index-events">
    <div class="index-events-title">
        <h1>Ongoing Events</h1>
    </div>

    <div class="ongoing-event-grid">
        <div class="ongoing-event-container">
            <div class="ongoing-event-wrapper">
                <ul class="ongoing-event-card-list">
                    <li class="ongoing-event-card-item">
                        <a href="#" class="ongoing-event-card-link">
                            <img src="/images/poster/falcon-poster.jpg" alt="falcons" class="card-img" />
                            <div class="hover-content">
                                <h3 class="hover-title">Falcon's Tournament</h3>
                            </div>
                        </a>

                    </li>
                </ul>
            </div>
        </div>

        <div class="ongoing-event-container">
            <div class="ongoing-event-wrapper">
                <ul class="ongoing-event-card-list">
                    <li class="ongoing-event-card-item">
                        <a href="#" class="ongoing-event-card-link">
                            <img src="/images/poster/Dota2-poster.jpg" alt="falcons" class="card-img" />
                            <div class="hover-content">
                                <h3 class="hover-title">Dota 2 Tournament</h3>
                            </div>
                        </a>
                    </li>
                </ul>
            </div>
        </div>


        <div class="ongoing-event-container">
            <div class="ongoing-event-wrapper">
                <ul class="ongoing-event-card-list">
                    <li class="ongoing-event-card-item">
                        <a href="#" class="ongoing-event-card-link">
                            <img src="/images/poster/lols-poster.jpg" alt="falcons" class="card-img" />
                            <div class="hover-content">
                                <h3 class="hover-title">League Of Legends Tournament</h3>
                            </div>
                        </a>
                    </li>
                </ul>
            </div>
        </div>


        <div class="ongoing-event-container">
            <div class="ongoing-event-wrapper">
                <ul class="ongoing-event-card-list">
                    <li class="ongoing-event-card-item">
                        <a href="#" class="ongoing-event-card-link">
                            <img src="/images/poster/valorants-poster.jpg" alt="falcons" class="card-img" />
                            <div class="hover-content">
                                <h3 class="hover-title">Valorant Tournament</h3>
                            </div>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


