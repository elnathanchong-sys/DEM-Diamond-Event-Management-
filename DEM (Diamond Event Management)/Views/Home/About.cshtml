@{
    ViewData["Title"] = "About Us";
}

<link rel="stylesheet" href="~/css/About.css" />

<div class="about-page">

    <section class="about-header">
        <h1>ABOUT DIAMOND EVENT MANAGEMENT</h1>

        <p>
            Creating exciting gaming tournaments and unforgettable
            experiences for players and teams.
        </p>
    </section>

    <section class="about-content">

        <div class="about-card">
            <h2>Who We Are</h2>

            <p>
                Diamond Event Management (DEM) is a gaming event
                management organization focused on creating exciting
                and competitive gaming tournaments.
            </p>

            <p>
                We bring gamers and teams together in a fun,
                organized and competitive environment where they
                can show their skills and enjoy gaming.
            </p>
        </div>

        <div class="about-card">
            <h2>What We Do</h2>

            <p>
                DEM organizes and manages gaming tournaments from
                registration to the final match.
            </p>

            <p>
                We handle tournament schedules, player and team
                registration, matches, results and rankings to make
                sure every event runs smoothly.
            </p>
        </div>

    </section>

    <section class="mission-section">

        <h2>Our Mission</h2>

        <p>
            Our mission is to provide fair, exciting and
            well-organized gaming tournaments where players can
            compete, improve their skills and connect with other
            gamers.
        </p>

    </section>

    <section class="values-section">

        <h2>What Makes DEM Different?</h2>

        <div class="values">

            <div class="value-box">
                <h3>Competitive</h3>

                <p>
                    We create tournaments that give players the
                    opportunity to challenge themselves and compete.
                </p>
            </div>

            <div class="value-box">
                <h3>Gaming</h3>

                <p>
                    Gaming is at the heart of everything we do.
                    We aim to make every tournament enjoyable.
                </p>
            </div>

            <div class="value-box">
                <h3>Community</h3>

                <p>
                    We bring players and teams together to build
                    a stronger gaming community.
                </p>
            </div>

        </div>

    </section>

    <section class="vision-section">

        <h2>Our Vision</h2>

        <p>
            Our vision is to become a trusted gaming event
            management organization known for exciting,
            fair and well-organized tournaments.
        </p>

    </section>

</div>