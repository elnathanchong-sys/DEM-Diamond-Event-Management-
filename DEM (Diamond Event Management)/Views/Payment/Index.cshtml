@model DEM__Diamond_Event_Management_.Models.Registration

@{
    ViewBag.Title = "Payment";
    Layout = "_Layout";
}

<div class="payment-container">

    <div class="payment-card">

        <h1>Complete Payment</h1>

        <p class="payment-subtitle">
            Complete your payment to confirm your registration.
        </p>

        <hr />

        <div class="payment-info">

            <div class="info-row">
                <span>Event</span>
                <strong>@Model.Event.Name</strong>
            </div>

            <div class="info-row">
                <span>Team</span>
                <strong>@Model.TeamName</strong>
            </div>

            <div class="info-row">
                <span>Registration ID</span>
                <strong>@Model.Id</strong>
            </div>

            <div class="info-row total">
                <span>Total Amount</span>
                <strong>
                    RM @Model.Event.Price.ToString("0.00")
                </strong>
            </div>

        </div>

        <hr />

        <h3>Payment Method</h3>

        @if (TempData["Error"] != null)
        {
            <div class="error-message">
                @TempData["Error"]
            </div>
        }

        <form method="post" action="/Payment/Pay">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="registrationId"
                   value="@Model.Id" />

            <label class="payment-option">
                <input type="radio"
                       name="paymentMethod"
                       value="Credit/Debit Card"
                       required />

                <span>
                    💳 Credit / Debit Card
                </span>
            </label>

            <label class="payment-option">
                <input type="radio"
                       name="paymentMethod"
                       value="Online Banking" />

                <span>
                    🏦 Online Banking
                </span>
            </label>

            <label class="payment-option">
                <input type="radio"
                       name="paymentMethod"
                       value="E-Wallet" />

                <span>
                    📱 E-Wallet
                </span>
            </label>

            <button type="submit" class="pay-button">
                Pay RM @Model.Event.Price.ToString("0.00")
            </button>

        </form>

    </div>

</div>