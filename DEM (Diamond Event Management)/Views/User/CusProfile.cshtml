@{
    ViewData["Title"] = "My Profile";
}

<link rel="stylesheet" href="~/css/user.css" />

<div class="profile-page">

    <!-- Cover -->
    <div class="cover">
        <img src="~/images/profile.jpg" class="avatar" />

        <div class="info">
            <h2>Ho Shin You</h2>
            <p>hsy@email.com</p>

            <span class="member gold">
                ★ Gold Member
            </span>
        </div>
    </div>

    <!-- Member Status -->
    <div class="member-card">

        <div>
            <h3>Membership Status</h3>
            <p>Gold Member since 2025</p>
        </div>

        <div class="points">
            <h2>1,280</h2>
            <span>Reward Points</span>
        </div>

    </div>

    <!-- Menu Cards -->
    <div class="menu">

        <a class="card" href="/Profile/UpcomingEvents">
            <h3>🎫 Upcoming Events</h3>
            <p>View all purchased event tickets and QR codes.</p>
        </a>

        <a class="card" href="/Profile/PurchaseHistory">
            <h3>🧾 Purchase History</h3>
            <p>See your previous ticket purchases and receipts.</p>
        </a>

        <a class="card" href="/Profile/Favourites">
            <h3>❤️ Favourite Games</h3>
            <p>Your saved games and interested events.</p>
        </a>

        <a class="card" href="/Profile/Settings">
            <h3>⚙️ Account Settings</h3>
            <p>Edit profile, password and notification settings.</p>
        </a>

    </div>

    <!-- Upcoming Event Preview -->
    <h3 class="section-title">My Upcoming Events</h3>

    <div class="event-list">

        <div class="event">

            <img src="~/images/valorant.jpg" />

            <div class="details">
                <h4>Valorant Community Cup</h4>
                <p>30 Aug 2026 · 2:00 PM</p>
                <p>Sunway Convention Centre</p>
            </div>

            <button>View Ticket</button>

        </div>

        <div class="event">

            <img src="~/images/mlbb.jpg" />

            <div class="details">
                <h4>MLBB Weekend Showdown</h4>
                <p>5 Sept 2026 · 11:00 AM</p>
                <p>Kuala Lumpur Esports Hub</p>
            </div>

            <button>View Ticket</button>

        </div>

    </div>

    <!-- Purchase History -->
    <h3 class="section-title">Recent Purchases</h3>

    <table class="history">

        <tr>
            <th>Event</th>
            <th>Date</th>
            <th>Amount</th>
            <th>Status</th>
        </tr>

        <tr>
            <td>Valorant Community Cup</td>
            <td>18 Aug 2026</td>
            <td>RM35</td>
            <td><span class="paid">Paid</span></td>
        </tr>

        <tr>
            <td>MLBB Weekend Showdown</td>
            <td>20 Aug 2026</td>
            <td>RM25</td>
            <td><span class="paid">Paid</span></td>
        </tr>

        <tr>
            <td>FIFA Campus League</td>
            <td>12 Jul 2026</td>
            <td>RM40</td>
            <td><span class="paid">Paid</span></td>
        </tr>

    </table>

</div>