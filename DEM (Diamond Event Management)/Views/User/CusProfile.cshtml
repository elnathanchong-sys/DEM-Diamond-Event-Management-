@model DEM__Diamond_Event_Management_.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<link rel="stylesheet" href="~/css/user.css" />

<div class="profile-page">

    <!-- Cover -->
    <div class="cover">
        @if (!string.IsNullOrEmpty(Model.UserImg))
        {
            <img src="~/images/@Model.UserImg" class="avatar" />
        }
        else
        {
            <img src="~/images/profile.jpg" class="avatar" />
        }

        <div class="info">
            <h2>@Model.Name</h2>
            <p>@Model.Email</p>

            <span class="member gold">
                ★ @Model.MembershipLevel Member
            </span>
        </div>
    </div>

    <!-- Member Status -->
    <div class="member-card">

        <div>
            <h3>Membership Status</h3>
            <p>Member since @Model.CreationDate.Year</p>
        </div>

        <div class="points">
            <h2>@Model.RewardPoints</h2>
            <span>Reward Points</span>
        </div>

    </div>

    <!-- Menu Cards -->
    <div class="menu">

        <a class="card" href="/Profile/UpcomingEvents">
            <h3>🎫 Upcoming Events</h3>
            <p>View all purchased event tickets and QR codes.</p>
        </a>

        <a class="card" href="/Profile/PurchaseHistory">
            <h3>🧾 Purchase History</h3>
            <p>See your previous ticket purchases and receipts.</p>
        </a>

        <a class="card" href="/Profile/Favourites">
            <h3>❤️ Favourite Games</h3>
            <p>Your saved games and interested events.</p>
        </a>

        <a class="card" href="/Profile/Settings">
            <h3>⚙️ Account Settings</h3>
            <p>Edit profile, password and notification settings.</p>
        </a>

    </div>

    <!-- Upcoming Event Preview -->
    <h3 class="section-title">My Upcoming Events</h3>

    <div class="event-list">

        <div class="event-list">

            @if (Model.UpcomingEvents.Any())
            {
                foreach (var item in Model.UpcomingEvents)
                {
                    <div class="event">

                        <img src="~/images/@item.PosterImg" />

                        <div class="details">

                            <h4>@item.EventName</h4>

                            <p>
                                @item.StartDate.ToString("dd MMM yyyy")
                                ·
                                @item.StartTime.ToString("hh:mm tt")
                            </p>

                            <p>@item.Venue</p>

                        </div>

                        <a href="/Profile/Ticket/@item.RegistrationId">
                            View Ticket
                        </a>

                    </div>
                }
            }
            else
            {
                <p>No upcoming events.</p>
            }

        </div>
        <div class="event">

            <img src="~/images/mlbb.jpg" />

            <div class="details">
                <h4>MLBB Weekend Showdown</h4>
                <p>5 Sept 2026 · 11:00 AM</p>
                <p>Kuala Lumpur Esports Hub</p>
            </div>

            <button>View Ticket</button>

        </div>

    </div>

    <!-- Purchase History -->
    <h3 class="section-title">Recent Purchases</h3>

    <table class="history">

        <tr>
            <th>Event</th>
            <th>Date</th>
            <th>Amount</th>
            <th>Status</th>
        </tr>

        @foreach (var purchase in Model.Purchases)
        {
            <tr>
                <td>@purchase.EventName</td>

                <td>
                    @purchase.RegistrationDate.ToString("dd MMM yyyy")
                </td>

                <td>
                    RM @purchase.Amount.ToString("0.00")
                </td>

                <td>
                    <span class="paid">
                        @purchase.Status
                    </span>
                </td>
            </tr>
        }

    </table>

</div>