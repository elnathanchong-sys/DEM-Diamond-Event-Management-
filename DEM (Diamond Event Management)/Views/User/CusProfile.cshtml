@model DEM__Diamond_Event_Management_.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<link rel="stylesheet" href="~/css/user.css" />

<div class="profile-container">

    <!-- Hero -->
    <div class="profile-hero">

        <div class="profile-left">

            @if (!string.IsNullOrEmpty(Model.UserImg))
            {
                <img src="~/images/@Model.UserImg" class="profile-avatar" />
            }
            else
            {
                <img src="~/images/profile.jpg" class="profile-avatar" />
            }

            <div>

                <h1>@Model.Name</h1>

                <p>@Model.Email</p>

                <span class="member-badge">
                    ★ @Model.MembershipLevel Member
                </span>

            </div>

        </div>

        <div class="reward-box">

            <h2>@Model.RewardPoints</h2>

            <span>Reward Points</span>

            <small>Member since @Model.CreationDate.Year</small>

        </div>

    </div>

    <!-- Quick Actions -->

    <div class="quick-actions">

        <a class="quick-card" href="/Profile/UpcomingEvents">
            <div class="icon">🎫</div>
            <h3>Upcoming</h3>
            <p>Your event tickets</p>
        </a>

        <a class="quick-card" href="/Profile/PurchaseHistory">
            <div class="icon">🧾</div>
            <h3>History</h3>
            <p>Past purchases</p>
        </a>

        <a class="quick-card" href="/Profile/Favourites">
            <div class="icon">❤️</div>
            <h3>Favourites</h3>
            <p>Saved games</p>
        </a>

        <a class="quick-card" href="/Profile/Settings">
            <div class="icon">⚙️</div>
            <h3>Settings</h3>
            <p>Manage account</p>
        </a>

    </div>

    <!-- Upcoming Events -->

    <div class="section-header">
        <h2>Upcoming Events</h2>
    </div>

    <div class="upcoming-slider">

        @if (Model.UpcomingEvents.Any())
        {
            foreach (var item in Model.UpcomingEvents)
            {
                <div class="event-card">

                    <img src="~/images/@item.PosterImg" />

                    <div class="event-content">

                        <h3>@item.EventName</h3>

                        <p>@item.StartDate.ToString("dd MMM yyyy")</p>

                        <p>@item.StartTime.ToString("hh:mm tt")</p>

                        <p>@item.Venue</p>

                        <a class="ticket-btn" href="/Profile/Ticket/@item.RegistrationId">
                            View Ticket
                        </a>

                    </div>

                </div>
            }
        }
        else
        {
            <p>No upcoming events.</p>
        }

    </div>

    <!-- Purchase History -->

    <div class="section-header">
        <h2>Purchase History</h2>
    </div>

    <div class="history-card">

        <table>

            <thead>

                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var purchase in Model.Purchases)
                {
                    <tr>

                        <td>@purchase.EventName</td>

                        <td>@purchase.RegistrationDate.ToString("dd MMM yyyy")</td>

                        <td>RM @purchase.Amount.ToString("0.00")</td>

                        <td>
                            <span class="status-paid">@purchase.Status</span>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>