@model DEM__Diamond_Event_Management_.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    var showAllUpcoming = ViewBag.ShowAllUpcoming == true;
    var showAllHistory = ViewBag.ShowAllHistory == true;
    var hasMoreUpcoming = ViewBag.HasMoreUpcoming == true;
    var hasMorePurchases = ViewBag.HasMorePurchases == true;
}

<link rel="stylesheet" href="~/css/user.css" />

<div class="profile-container">
    <section class="profile-hero">
        <div class="profile-left">
            @if (!string.IsNullOrEmpty(Model.UserImg))
            {
                <img src="~/images/@Model.UserImg" class="profile-avatar" />
            }
            else
            {
                <img src="~/images/profile.jpg" class="profile-avatar" />
            }

            <div class="profile-title-wrap">
                <span class="profile-kicker">Member Dashboard</span>
                <h1>@Model.Name</h1>
                <p>@Model.Email</p>

                <span class="member-badge">
                    <i class="bx bx-shield-quarter"></i> @Model.MembershipLevel Member
                </span>
            </div>
        </div>

        <aside class="reward-box">
            <span class="reward-label">Reward Points</span>
            <h2>@Model.RewardPoints</h2>
            <small>Member since @Model.CreationDate.Year</small>

            <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-button">
                    <i class="bx bx-log-out"></i> Logout
                </button>
            </form>
        </aside>
    </section>

    <section class="quick-actions">
        <a class="quick-card" href="#upcoming-events">
            <span class="icon"><i class="bx bx-calendar-event"></i></span>
            <h3>Upcoming</h3>
            <p>@Model.UpcomingEvents.Count Events</p>
        </a>

        <a class="quick-card" href="#event-history">
            <span class="icon"><i class="bx bx-receipt"></i></span>
            <h3>Event History</h3>
            <p>@Model.Purchases.Count Records</p>
        </a>

        <a class="quick-card" href="/User/EditProfile">
            <span class="icon"><i class="bx bx-edit"></i></span>
            <h3>Edit Profile</h3>
            <p>Update account</p>
        </a>

        <a class="quick-card" href="#">
            <span class="icon"><i class="bx bx-cog"></i></span>
            <h3>Settings</h3>
            <p>Manage account</p>
        </a>
    </section>

    <section class="profile-content-grid">
        <section class="profile-section-card" id="upcoming-events">
            <div class="section-header">
                <div>
                    <span class="section-kicker">Registered Events</span>
                    <h2>Upcoming Events</h2>
                </div>
                <a class="view-all-link" href="@Url.Action("EventList", "Home")">
                    <i class="bx bx-grid-alt"></i> Explore All
                </a>
                @if (hasMoreUpcoming || showAllUpcoming)
                {
                    <a class="view-all-link" href="@Url.Action("Cusprofile", "Profile", new { showAllUpcoming = !showAllUpcoming, showAllHistory = showAllHistory })#upcoming-events">
                        <i class="bx @(showAllUpcoming ? "bx-chevron-up" : "bx-list-ul")"></i>
                        @(showAllUpcoming ? "Show less" : "Show all")
                    </a>
                }
            </div>

            @if (Model.UpcomingEvents.Any())
            {
                <div class="upcoming-slider">
                    @foreach (var item in Model.UpcomingEvents)
                    {
                        <article class="event-card">
                            <div class="event-card-image">
                                @if (!string.IsNullOrWhiteSpace(item.PosterImg))
                                {
                                    <img src="~/uploads/@item.PosterImg" alt="@item.EventName" />
                                }
                                else
                                {
                                    <img src="~/images/diamond.png" alt="@item.EventName" />
                                }
                            </div>

                            <div class="event-content">
                                <div class="event-title-line">
                                    <h3>@item.EventName</h3>
                                </div>
                                <div class="event-meta-list">
                                    <span><i class="bx bx-calendar"></i> @item.StartDate.ToString("dd MMM yyyy")</span>
                                    <span><i class="bx bx-time-five"></i> @item.StartTime.ToString("hh:mm tt")</span>
                                    <span><i class="bx bx-map"></i> @item.Venue</span>
                                </div>
                                @if (item.HasPayment)
                                {
                                    <a class="ticket-btn" href="@Url.Action("Receipt", "Profile", new { id = item.RegistrationId })">
                                        <i class="bx bx-printer"></i> Print Receipt
                                    </a>
                                }
                                else
                                {
                                    <div class="unpaid-event-message">
                                        <i class="bx bx-info-circle"></i> You didn't pay for this event yet.
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bx bx-calendar-x"></i>
                    <p>No upcoming events registered yet.</p>
                </div>
            }
        </section>

        <section class="profile-section-card" id="event-history">
            <div class="section-header">
                <div>
                    <span class="section-kicker">Registration Activity</span>
                    <h2>Event History</h2>
                </div>
                @if (hasMorePurchases || showAllHistory)
                {
                    <a class="view-all-link" href="@Url.Action("Cusprofile", "Profile", new { showAllHistory = !showAllHistory, showAllUpcoming = showAllUpcoming })#event-history">
                        <i class="bx @(showAllHistory ? "bx-chevron-up" : "bx-list-ul")"></i>
                        @(showAllHistory ? "Show less" : "Show all")
                    </a>
                }
            </div>

            @if (Model.Purchases.Any())
            {
                <div class="history-card">
                    @foreach (var purchase in Model.Purchases)
                    {
                        <div class="history-row">
                            <div class="history-primary">
                                <span class="history-event-name">@purchase.EventName</span>
                                <span class="history-date">@purchase.RegistrationDate.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="history-secondary">
                                <span class="history-amount">RM @purchase.Amount.ToString("0.00")</span>
                                @if (purchase.Status == "Pending")
                                {
                                    <span class="status-pending">Waiting for admin approval</span>
                                }
                                else if (purchase.Status == "Approved" && purchase.HasPayment)
                                {
                                    <span class="status-paid">Paid</span>
                                }
                                else if (purchase.Status == "Approved")
                                {
                                    <span class="status-paid">Approved</span>
                                    <a class="ticket-btn" href="/Payment/Index?registrationId=@purchase.RegistrationId">Pay Now</a>
                                }
                                else
                                {
                                    <span class="status-paid">@purchase.Status</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bx bx-receipt"></i>
                    <p>No event history available.</p>
                </div>
            }
        </section>
    </section>
</div>
