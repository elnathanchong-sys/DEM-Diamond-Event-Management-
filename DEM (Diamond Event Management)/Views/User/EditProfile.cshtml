@model DEM__Diamond_Event_Management_.Models.EditProfileViewModel
@{
    ViewBag.Title = "Edit Profile";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/user.css" />

<div class="profile-container">
    <section class="profile-hero edit-profile-hero">
        <div class="profile-left">
            @if (!string.IsNullOrEmpty(Model.UserImg))
            {
                <img src="~/images/@Model.UserImg" class="profile-avatar" />
            }
            else
            {
                <img src="~/images/profile.jpg" class="profile-avatar" />
            }

            <div class="profile-title-wrap">
                <span class="profile-kicker">Account Settings</span>
                <h1>@Model.Name</h1>
                <p>@Model.Email</p>
            </div>
        </div>

        <aside class="reward-box compact-reward">
            <span class="reward-label">Account</span>
            <h2>Profile</h2>
            <small>Member details</small>
        </aside>
    </section>

    <section class="edit-profile-card">
        <div class="edit-profile-card-header">
            <div>
                <span class="section-kicker">Member Information</span>
                <h2>Edit Your Profile</h2>
            </div>
            <a href="/User/CusProfile" class="back-link">
                <i class="bx bx-arrow-back"></i> Back to Profile
            </a>
        </div>

        @if (TempData["Info"] != null)
        {
            <div class="profile-success-message">@TempData["Info"]</div>
        }

        <form asp-action="EditProfile" asp-controller="User" method="post" enctype="multipart/form-data" class="profile-edit-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="Name">Full Name</label>
                    <input asp-for="Name" placeholder="Enter your full name" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Email">Email Address</label>
                    <input asp-for="Email" readonly />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Phone">Phone Number</label>
                    <input asp-for="Phone" placeholder="Enter your phone number" />
                    <span asp-validation-for="Phone" class="field-validation-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Gender">Gender</label>
                    <select asp-for="Gender">
                        <option value="">Select</option>
                        <option value="M">Male</option>
                        <option value="F">Female</option>
                    </select>
                    <span asp-validation-for="Gender" class="field-validation-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Country">Country</label>
                    <input asp-for="Country" placeholder="Country" />
                    <span asp-validation-for="Country" class="field-validation-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="State">State</label>
                    <input asp-for="State" placeholder="State" />
                    <span asp-validation-for="State" class="field-validation-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="City">City</label>
                    <input asp-for="City" placeholder="City" />
                    <span asp-validation-for="City" class="field-validation-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="HouseNo">House No</label>
                    <input asp-for="HouseNo" placeholder="House number" />
                    <span asp-validation-for="HouseNo" class="field-validation-error"></span>
                </div>

                <div class="form-field full-width">
                    <label asp-for="Address">Address</label>
                    <textarea asp-for="Address" rows="4" placeholder="Enter your address"></textarea>
                    <span asp-validation-for="Address" class="field-validation-error"></span>
                </div>

                <div class="form-field full-width">
                    <label for="userPhoto">Profile Photo</label>
                    <div class="file-drop" data-file-drop-zone>
                        <div class="profile-image-preview">
                            <img id="profileImagePreview" src="@(string.IsNullOrEmpty(Model.UserImg) ? Url.Content("~/images/profile.jpg") : Url.Content("~/images/" + Model.UserImg))" alt="Profile preview" />
                        </div>
                        <input id="userPhoto" type="file" name="userPhoto" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="file-input" data-image-preview="#profileImagePreview" />
                        <label for="userPhoto" class="file-drop-label">
                            <span class="file-drop-icon"><i class="bx bx-cloud-upload"></i></span>
                            <span class="file-drop-text">
                                <span class="file-drop-title">Drop photo here</span>
                                <span class="file-drop-subtitle">or click to browse</span>
                            </span>
                            <span class="file-drop-button">Choose Image</span>
                        </label>
                        <span class="file-helper" data-file-status>No new image selected</span>
                        <span class="field-validation-error" data-file-validation></span>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <a href="/User/CusProfile" class="cancel-button">Cancel</a>
                <button type="submit" class="save-button">
                    <i class="bx bx-save"></i> Save Changes
                </button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <script src="~/js/profile-edit.js"></script>
}
