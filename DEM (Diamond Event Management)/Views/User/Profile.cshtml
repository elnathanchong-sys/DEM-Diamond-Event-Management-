@{
    ViewBag.Title = "My Profile";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/user.css" />


<!-- PROFILE BANNER -->
<section class="profile-banner">

    <div class="profile-info">

        <img src="/images/profile.jpg"
             class="profile-picture"
             alt="Profile Picture" />

        <div class="profile-details">

            <h1>ShinYou</h1>

            <p>shinyou@email.com</p>

            <span class="role">
                Tournament Player
            </span>

        </div>

    </div>

</section>

<form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
    @Html.AntiForgeryToken()
    <button type="submit" class="logout-button">
        <i class="bx bx-log-out"></i> Logout
    </button>
</form>

<!-- PROFILE STATISTICS -->
<section class="stats">

    <div class="stat">
        <h2>12</h2>
        <p>Tournaments Joined</p>
    </div>

    <div class="stat">
        <h2>3</h2>
        <p>Tournaments Won</p>
    </div>

    <div class="stat">
        <h2>2</h2>
        <p>My Teams</p>
    </div>

    <div class="stat">
        <h2>28</h2>
        <p>Matches Played</p>
    </div>

</section>


<!-- PROFILE MENU -->
<section class="profile-menu">

    <div class="cards">

        <!-- UPCOMING TOURNAMENTS -->
        <a href="/Tournament/MyTournaments"
           class="card">

            <div class="card-icon">🏆</div>

            <h3>My Upcoming Tournaments</h3>

            <p>
                View tournaments you have registered
                for and upcoming matches.
            </p>

        </a>



        <!-- TOURNAMENT HISTORY -->
        <a href="/Tournament/History"
           class="card">

            <div class="card-icon">📜</div>

            <h3>Tournament History</h3>

            <p>
                View your previous tournaments,
                results and achievements.
            </p>

        </a>


        <!-- ACCOUNT SETTINGS -->
        <a href="/Profile/Settings"
           class="card">

            <div class="card-icon">⚙️</div>

            <h3>Account Settings</h3>

            <p>
                Manage your profile, password
                and account preferences.
            </p>

        </a>

    </div>


    <!-- PROFILE BUTTONS -->
    <div class="profile-buttons">

        <a href="/Profile/Edit"
           class="btn edit-btn">
            ✏️ Edit Profile
        </a>

        <a href="/Profile/Settings"
           class="btn settings-btn">
            ⚙️ Account Settings
        </a>

    </div>
