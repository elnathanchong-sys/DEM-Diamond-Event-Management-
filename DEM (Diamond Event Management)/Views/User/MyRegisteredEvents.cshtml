@model List<DEM__Diamond_Event_Management_.Models.ProfileEventViewModel>

@{
    ViewData["Title"] = "My Registered Events";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/user.css" />

<div class="profile-container">
    <section class="profile-hero edit-profile-hero">
        <div class="profile-left">
            <div class="profile-title-wrap">
                <span class="profile-kicker">Member Events</span>
                <h1>My Registered Events</h1>
                <p>All events registered under your account.</p>
            </div>
        </div>

        <aside class="reward-box compact-reward">
            <span class="reward-label">Registered</span>
            <h2>@Model.Count</h2>
            <small>Event Records</small>
        </aside>
    </section>

    <section class="registered-events-panel">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bx bx-calendar-x"></i>
                <p>You have not registered for any events yet.</p>
                <a class="view-all-link" href="/Event/EventRead">Explore Events</a>
            </div>
        }
        else
        {
            <div class="registered-events-grid">
                @foreach (var item in Model)
                {
                    <article class="registered-event-card">
                        <div class="registered-event-image">
                            <img src="~/images/@item.PosterImg" alt="@item.EventName" />
                        </div>

                        <div class="registered-event-content">
                            <div class="registered-event-top">
                                <span class="registered-event-type">Registered</span>
                                <span class="registered-event-date">@item.StartDate.ToString("dd MMM yyyy")</span>
                            </div>

                            <h3>@item.EventName</h3>

                            <div class="registered-event-meta">
                                <span><i class="bx bx-time-five"></i> @item.StartTime.ToString("hh:mm tt")</span>
                                <span><i class="bx bx-map"></i> @item.Venue</span>
                            </div>

                            <div class="registered-event-actions">
                                <a class="ticket-btn" href="/Profile/Ticket/@item.RegistrationId">
                                    <i class="bx bx-download"></i>View Ticket
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>
