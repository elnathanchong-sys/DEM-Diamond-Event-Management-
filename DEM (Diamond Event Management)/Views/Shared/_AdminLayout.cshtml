@using System.Security.Claims
@inject DB db

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width" initial-scale="1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/darklight.css" />
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/event.css">
    <link rel="stylesheet" href="/css/Category.css">
    <link rel="stylesheet" href="/css/registration.css">
    <link rel="stylesheet" href="/css/IndexBanner.css">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bree+Serif&display=swap" rel="stylesheet">
    @RenderSection("head", required: false)
</head>
<body>

    <button class="menu-button" id="menuBtn">
        <i class="fa-solid fa-bars"></i>
    </button>

    <div class="sidebar">

        <ul>
            <li>
                <a href="#" class="logo">
                    <span class="icon">💎</span>
                    <span class="text">DEM</span>

                </a>
            </li>
            <li>
                <a href="/Home/Index">
                    <span class="icon"><i class="fa-solid fa-house"></i></span>
                    <span class="text">Home</span>
                </a>
            </li>
            <li>
                <a href="/Admin/Index">
                    <span class="icon"><i class="fa-solid fa-user"></i></span>
                    <span class="text">Dashbord</span>
                </a>
            </li>
            <li>
                <a href="/IndexBanner/IndexBannerRead">
                    <span class="icon"><i class="fa-solid fa-image"></i></span>
                    <span class="text">Index Banner</span>
                </a>
            </li>
            <li>
                <a href="/Event/EventRead">
                    <span class="icon"><i class="fa-solid fa-calendar-days"></i></span>
                    <span class="text">Manage Events</span>
                </a>
            </li>
            <li>
                <a href="/Category/CatRead">
                    <span class="icon"><i class="fa-solid fa-tags"></i></span>
                    <span class="text">Categories</span>
                </a>
            </li>

            <li>
                <a href="/Venue/Index">
                    <span class="icon"><i class="fa-solid fa-location-dot"></i></span>
                    <span class="text">Manage Venues</span>
                </a>
            </li>

            <ul>
                <li>
                    <a href="/Admin/ReadUser">
                        <span class="icon"><i class="fa-solid fa-users"></i></span>
                        <span class="text">Manage Users</span>
                    </a>
                </li>
                <li>
                    <a href="/Registration/RegistrationEvents">
                        <span class="icon"><i class="fa-solid fa-clipboard-check"></i></span>
                        <span class="text">Team Approvals</span>
                    </a>
                </li>
                <li>
                    <a href="/Admin/Notifications">
                        <span class="icon"><i class="fa-solid fa-bell"></i></span>
                        <span class="text">Notifications</span>
                    </a>
                </li>
                <li>
                    <a href="/Admin/ReadAdmin">
                        <span class="icon"><i class="fa-solid fa-user-shield"></i></span>
                        <span class="text">Administrators</span>
                    </a>
                </li>
                @*
                <li>
                    <a href="/Admin/EditMyProfile">
                        <span class="icon"><i class="fa-solid fa-user-gear"></i></span>
                        <span class="text">Edit My Profile</span>
                    </a>
                </li>
                *@
            </ul>
            <li class="theme-toggle-item">
                <a href="#" class="theme-toggle">
                    <span class="icon"><i class="bx bx-sun"></i></span>
                    <span class="text theme-toggle-label">Light mode</span>
                </a>
            </li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-logout">
                        <span class="icon"><i class="fa-solid fa-arrow-right-from-bracket"></i></span>
                        <span class="text">Logout</span>
                    </button>
                </form>
            </li>
        </ul>

        <li class="session-view">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                string? sessionEmail = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                var sessionUser = sessionEmail == null ? null : db.User.Find(sessionEmail);

                <li class="session-info-item">
                    <div class="session-info">
                        <span class="icon"><i class="fa-solid fa-circle-user"></i></span>
                        <span class="text session-info-text">
                            <span class="session-info-name">@(sessionUser != null ? sessionUser.Name : sessionEmail)</span>
                            <span class="session-info-role">@User.FindFirst(ClaimTypes.Role)?.Value</span>
                        </span>
                    </div>
                </li>
            }
        </li>
    </div>

    <main>
        @RenderBody()
    </main>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/jquery.validate.min.js"></script>
    <script src="/js/jquery.validate.unobstrusive.min.js"></script>
    <script src="/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="/js/admin.js"></script>
    <script src="/js/app.js"></script>
    <script src="/js/registration.js"></script>
    <script src="/js/darklight.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
