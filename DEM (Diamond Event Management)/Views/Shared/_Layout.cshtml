@using System.Security.Claims
@inject DB db

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width" initial-scale="1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/cards.css" />
    <link rel="stylesheet" href="/css/home.css" />
    <link rel="stylesheet" href="/css/eventlist.css" />
    <link rel="stylesheet" href="~/css/darklight.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com"> @*Google Fonts*@
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin> @*Google Fonts*@
    <link href="https://fonts.googleapis.com/css2?family=Bree+Serif&display=swap" rel="stylesheet"> @*Bree Serif Font*@
    <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet"> @*boxicons*@
    @RenderSection("head", required: false)
</head>
<body>
    <header>
        <nav>
            <div class="left-icon">
                <a href="/Home/Index"><img src="/images/icon/logo.png" alt="DEM Logo"></a>
                <a href="/Home/Index" class="no-underlined"> Diamond Event Management</a>

            </div>

            <div class="navigation-bar">
                <a href="/Event/EventRead" class="no-underlined">Home</a>
                <a href="/Home/EventList" class="no-underlined">Events</a>
                <a asp-controller="Home" asp-action="FAQ" class="no-underlined">FAQs</a>
                <a href="/Home/About" class="no-underlined">About Us</a>
            </div>

   
            <div class="right-icon">
            @*
                <div class="hpsearch-wrapper">
                    <a href="#" id="hpsearchIconBtn"><img src="/images/icon/search icon.png" width="20" alt="Search"></a>

                    <div class="hpsearch-dropdown" id="hpsearchDropdown">
                        <form action="/page/search.php" method="GET">
                            <input type="text" name="q" id="hpsearchInput" placeholder="Search products..." autocomplete="off">
                        </form>
                        <div id="hpsearchResults" class="hpsearch-results-list"></div>
                    </div>
                </div>
            </div>

            <div class="right-icon">
                <div class="search-section">
                    <form method="get" action="/Home/EventList">
                        <input type="search"
                               name="name"
                               class="search-input"
                               placeholder="Search event..."
                               value="@Context.Request.Query["name"]" />
                    </form> @*copied from HO's eventcreate search bar function not added yet
                </div>
                <a href="/Account/Login" class="user-icon">
                    <i class="bx bx-cart"></i>
                </a>
            *@
                <a href="/Home/Announcements" class="bell-icon" aria-label="View announcements">
                    <i class="bx bx-bell"></i>
                </a>
                <button type="button" class="theme-toggle">
                    <i class="bx bx-moon"></i>
                </button>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    string? sessionEmail = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                    var sessionUser = sessionEmail == null ? null : db.User.Find(sessionEmail);

                    <a href="/User/CusProfile" class="session-info">
                        <i class="bx bx-user-circle"></i>
                        <span class="session-info-text">
                            <span class="session-info-name">@(sessionUser != null ? sessionUser.Name : sessionEmail)</span>
                            <span class="session-info-role">@User.FindFirst(ClaimTypes.Role)?.Value</span>
                        </span>
                    </a>
                }
                else
                {
                    <a href="/Account/Login" class="session-info">
                        <i class="bx bx-user-circle"></i>
                        <span class="session-info-text">
                            <span class="session-info-name">Register <br /> Now</span>
                        </span> 
                    </a>
                }
            </div>

        </nav>
    </header>
    <main>
        @RenderBody()
    </main>

    <button type="button" id="backToTopBtn" class="back-to-top-btn" title="Back to top">
        <i class="bx bx-up-arrow-alt"></i>
    </button>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/jquery.validate.min.js"></script>
    <script src="/js/jquery.validate.unobstrusive.min.js"></script>
    <script src="/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="/js/app.js"></script>
    <script src="/js/darklight.js"></script>
    <script src="/js/event.js"></script>

    @RenderSection("Scripts", required: false)
    @await RenderSectionAsync("foot", required: false)

</body>
</html>